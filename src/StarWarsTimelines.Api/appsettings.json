{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/starwarstimelines-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 31,
                "shared": true,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=starwarstimelines.db"
  },
  "Jwt": {
    "Issuer": "StarWarsTimelinesApi",
    "Audience": "StarWarsTimelinesClient",
    "SecretKey": "StarWarsTimelines-Dev-Secret-Key-Change-Me-2026",
    "ExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "FromAddress": "onboarding@resend.dev",
    "FromName": "Star Wars Timelines",
    "SmtpHost": "smtp.resend.com",
    "SmtpPort": 587,
    "SmtpUsername": "resend",
    "SmtpPassword": "",
    "SmtpEnableSsl": true,
    "VerificationUrl": "https://localhost:4200/verify-email"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
